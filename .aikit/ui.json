{
  "schema": 1,
  "surfaces": {
    "studio": {
      "paths": [
        "index.html",
        "src/**"
      ]
    }
  },
  "protected": [
    "tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/__tests__/**"
  ],
  "commands": {
    "fast": "npm test",
    "snapshot": "node scripts/ui-inventory.mjs"
  },
  "style": {
    "theme_paths": [
      "src/theme.css"
    ]
  },
  "limits": {
    "max_files": 12,
    "max_lines": 300
  }
}